# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.

# Database PostgreSQL (Neon, gratis: https://neon.tech). Ambil dari Neon → Connect.
# DATABASE_URL = koneksi "pooled" (host mengandung "-pooler") + &pgbouncer=true
# DIRECT_URL   = koneksi langsung (host tanpa "-pooler"), dipakai prisma db push
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Rahasia untuk menandatangani sesi login (string acak panjang, mis. hasil: openssl rand -base64 32).
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# "1" = tampilkan tombol akun demo di halaman login walau mode produksi (untuk demo/presentasi).
TAMPILKAN_AKUN_DEMO="1"

# Sumber data cuaca: "dummy" (default) atau "bmkg".
CUACA_MODE="dummy"

# Pengiriman notifikasi: "simulasi" (cetak ke console) atau "live".
NOTIFIKASI_MODE="simulasi"

# Alamat aplikasi yang dituju scripts/simulasi-sensor.ts.
SIMULASI_URL="http://localhost:3000"
